# Backend configuration only. Do not commit real credentials.
CloudinarySettings__CloudName=
CloudinarySettings__ApiKey=
CloudinarySettings__ApiSecret=

# Groq shopping assistant: paste your key into .env, then restart the application.
Groq__ApiKey=
Groq__Model=openai/gpt-oss-120b

# VNPay / MoMo sandbox. Paste your own merchant credentials; gateways activate automatically.
# Optional HTTPS origin override. Leave blank to use the current website origin. Public IPN still needs a domain/tunnel.
Payments__PublicBaseUrl=
Vnpay__TmnCode=
Vnpay__HashSecret=
Vnpay__BaseUrl=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
MomoAPI__PartnerCode=
MomoAPI__AccessKey=
MomoAPI__SecretKey=
MomoAPI__Endpoint=https://test-payment.momo.vn/v2/gateway/api/create
