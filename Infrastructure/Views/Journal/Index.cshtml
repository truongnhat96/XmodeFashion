@model IReadOnlyList<Infrastructure.Data.Fashion.FashionPost>
@{ ViewData["Title"] = "Tạp chí"; }
<section class="xm-section"><div class="xm-section-heading"><h1>Tạp chí Xmode</h1>@if (User.IsInRole("Admin")) { <a class="xm-button" href="/Article">+ Thêm bài viết</a> }</div>
<form method="get"><label>Tìm bài viết <input type="search" name="keyword" value="@Context.Request.Query["keyword"]"></label><button class="xm-button xm-outline">Tìm</button></form>
@if (Model.Count == 0) { <div class="xm-empty"><h2>Chưa có bài viết nào.</h2></div> }
<div class="xm-grid">@foreach(var post in Model) { <article class="xm-card"><a href="/Post/@post.Id">@if (!string.IsNullOrEmpty(post.ImageUrl)) { <img src="@post.ImageUrl" alt="@post.Title" loading="lazy" /> }<h2>@post.Title</h2></a><p>@post.CreatedAt.ToString("dd/MM/yyyy") · @post.User.DisplayName</p>@if(User.IsInRole("Admin")) { <a href="/Article/@post.Id">Sửa</a><form method="post" action="/Article/@post.Id/delete" onsubmit="return confirm('Xóa bài viết?')">@Html.AntiForgeryToken()<button type="submit">Xóa</button></form> }</article> }</div></section>
